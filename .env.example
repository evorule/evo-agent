# LLM 提供商配置模板
# 注意：本文件不会自动加载（evo-agent 无 dotenv 依赖）——
# 启动前需将变量注入进程环境（如 PowerShell：$env:MINIMAX_API_KEY="<key>" 后再启动 evo-agent serve）。

# MiniMax API 配置（优先使用）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M2.5
# 端点须与 key 签发区域同域：国内 key 用 api.minimaxi.com（域名多一个 i），国际 key 用 api.minimax.io；
# 区域不匹配会报 invalid api key。
MINIMAX_API_BASE=https://api.minimax.io/v1/text/chatcompletion_v2

# DeepSeek API 配置（当 MiniMax 未设置时使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1/chat/completions

# OpenAI API 配置（当以上都未设置时使用）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1/chat/completions
