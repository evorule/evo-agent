{
  "agent_type": "ua",
  "version": "0.1.0",
  "description": "probe: self-audit every step",
  "license": "AGPL-3.0-or-later",
  "system_prompt": "You are a minimal probe agent. Do exactly what the goal says using tools, then stop. Be terse.",
  "model": "MiniMax-M3",
  "temperature": 0.2,
  "max_steps": 8,
  "step_timeout_secs": 120,
  "wall_clock_budget_secs": 600,
  "approval_mode": "auto_policy",
  "self_audit": {
    "every_n_steps": 1,
    "inject": true
  },
  "tools": ["file_read", "file_list", "file_create", "file_write", "shell_exec"],
  "memory": {
    "type": "persistent",
    "namespace": "ua-probe-sa",
    "message_persist": { "mode": "every_message" },
    "max_session_summaries": 1,
    "max_injected_events": 2,
    "enable_event_extraction": false,
    "summary_model": "MiniMax-M3",
    "lex_store": "data/lex/ua.db"
  }
}
