{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "com.evorule.constraint.model_allowlist",
  "version": "1.3.0",
  "metadata": {
    "tier": "constraint",
    "title": "会话模型准入白名单",
    "description": "本工作区仅允许准入白名单内的模型发起 LLM 会话（call_external）。拦截未授权模型的会话命令，用于治理接入本工作区的 agent 与外部客户端的模型准入。白名单以 in 域集合成员判定表达，多模型准入只需扩 values 数组。"
  },
  "transform": [
    {
      "type": "enforce",
      "params": {
        "domain": {
          "type": "all",
          "inner": [
            {
              "type": "instruction",
              "instruction_type": "call_external"
            },
            {
              "type": "not",
              "inner": {
                "type": "in",
                "path": "instruction.params.model",
                "values": [
                  "MiniMax-M2.5","MiniMax-M3",
                  "deepseek-chat","deepseek-reasoner",
                  "kimi-k3.1-pro","kimi-k3.1-pro-highspeed","kimi-k2.7-code",
                  "glm-5.3","glm-5.3-flash","glm-5.3-flashx","glm-4.6","glm-4.5-air",
                  "doubao-seed-2-1-pro-260915","doubao-seed-2-1-lite-260915",
                  "step-5-preview","step-3.7-flash",
                  "qwen3-max","qwen-plus",
                  "gpt-6.1-sol","gpt-6.1-terra"
                ],
                "on_missing": "error"
              }
            }
          ]
        },
        "reason": "会话模型不在本工作区准入白名单（仅允许 MiniMax-M2.5/M3、deepseek-chat/reasoner、kimi-k3.1-pro(-highspeed)/kimi-k2.7-code、glm-5.3(-flash/-flashx)/glm-4.6/glm-4.5-air、doubao-seed-2-1-pro/lite-260915、step-5-preview/step-3.7-flash、qwen3-max/qwen-plus、gpt-6.1-sol/gpt-6.1-terra）"
      }
    }
  ]
}
