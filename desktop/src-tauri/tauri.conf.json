{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "evo-agent-desktop",
  "version": "0.5.6",
  "identifier": "com.evorule.evo-agent-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QjhBNzFBODkyMjFBQkUKUldTK0dpS0pHcWU0MWZteXFlZVgwYm1DWVZ4TFRQK0RBMmgrSkJTdVBlbnZyaFNjVENBbDdOWmIK",
      "endpoints": [
        "https://github.com/evorule/evo-agent-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/bin/*",
      "resources/evo-agent/**/*",
      "resources/evorule-server/**/*",
      "resources/console/**/*",
      "resources/license/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
