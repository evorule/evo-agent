{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "evo-agent-desktop",
  "version": "0.2.0",
  "identifier": "com.evorule.evo-agent-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/bin/*",
      "resources/evo-agent/**/*",
      "resources/evorule-server/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
